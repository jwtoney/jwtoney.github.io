{% comment %}
  Project card. The whole card is a link to the project page, so the external
  resource links (code repository, dataset) are rendered in their own block after
  that anchor closes — nesting an <a> inside an <a> is invalid and browsers
  restructure it, which breaks the inner link.
{% endcomment %}
<div class="col">
  <div class="card h-100 hoverable">
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "(min-width: 768px) 450px, 95vw"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    {% if project.github or project.zenodo %}
      <div class="card-body project-links pt-0">
        {% if project.github %}
          <span class="project-link" data-toggle="tooltip" title="Code repository">
            <a href="{{ project.github }}"><i class="fa-brands fa-github"></i></a>
          </span>
          {% if project.github_stars %}
            <span class="stars" data-toggle="tooltip" title="GitHub stars">
              <i class="fa-solid fa-star"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        {% endif %}
        {% if project.zenodo %}
          <span class="project-link" data-toggle="tooltip" title="Dataset on Zenodo">
            <a href="{{ project.zenodo }}"><i class="ai ai-zenodo"></i></a>
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
